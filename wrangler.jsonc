{
  // Giù dalla Torre Online — un solo Worker: asset statici + API + WebSocket, una stanza = un Durable Object (SQLite).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "giu-dalla-torre",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo queste rotte passano dal Worker: gli asset statici non consumano richieste Worker.
    "run_worker_first": ["/api/*", "/ws/*", "/oggi/*", "/t/*"]
  },
  "durable_objects": { "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }, { "name": "TORRI", "class_name": "TowerPoll" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }, { "tag": "v2", "new_sqlite_classes": ["TowerPoll"] }]
}
